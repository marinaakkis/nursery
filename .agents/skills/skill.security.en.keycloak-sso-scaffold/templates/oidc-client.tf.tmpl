{# OIDC client template — covers auth_code (public/confidential) and client_credentials.
   Substitute every {{placeholder}}. Drop blocks that do not apply.
   Render to: keycloak-handoff/{{app_name}}.tf  (inside the developer's repo).
   DevOps will copy this file to: route66/TFCODE/{{app_name}}.tf
   Run `terraform fmt` after writing.
-#}
// ============================================================================
//  HANDOFF FILE FOR THE SSO PLATFORM TEAM
//  Source app:        {{source_app_repo}}
//  Generated by:      keycloak-sso-scaffold skill on {{generated_at}}
//  Auth scenario:     {{auth_scenario}} ({{client_type_or_m2m}})
//
//  DevOps action: copy this file to `route66/TFCODE/{{app_name}}.tf`,
//                 open an MR, apply.
//
//  CLIENT_SECRET is intentionally NOT set here. After `terraform apply`,
//  read the auto-generated secret from the Keycloak Admin UI:
//      Clients -> {{app_name}} -> Credentials -> Client secret
//  and hand it to the requesting developer through the corporate
//  secret-sharing channel (Vault / password share). Never via git, ticket
//  comments, Slack, email.
// ============================================================================

resource "keycloak_openid_client" "{{app_name_tf}}" {
  realm_id  = keycloak_realm.biocad.id
  client_id = "{{app_name}}"
  name      = "{{app_name}}"

  enabled     = true
  login_theme = "keycloak"

{# --- Auth Code Flow (public, SPA / mobile) -------------------------------- #}
{%- if auth_scenario == "auth_code" and client_type == "public" %}
  access_type                  = "PUBLIC"
  standard_flow_enabled        = true
  direct_access_grants_enabled = false
  implicit_flow_enabled        = false
  service_accounts_enabled     = false
  pkce_code_challenge_method   = "S256"

  valid_redirect_uris = [
{%- for uri in redirect_uris %}
    "{{uri}}",
{%- endfor %}
  ]
  web_origins = [
{%- for origin in web_origins %}
    "{{origin}}",
{%- endfor %}
  ]
{%- endif %}

{# --- Auth Code Flow (confidential, server-side web) ----------------------- #}
{%- if auth_scenario == "auth_code" and client_type == "confidential" %}
  access_type                  = "CONFIDENTIAL"
  standard_flow_enabled        = true
  direct_access_grants_enabled = false
  implicit_flow_enabled        = false
  service_accounts_enabled     = false

  valid_redirect_uris = [
{%- for uri in redirect_uris %}
    "{{uri}}",
{%- endfor %}
  ]
  web_origins = [
{%- for origin in web_origins %}
    "{{origin}}",
{%- endfor %}
  ]
{%- endif %}

{# --- Client Credentials (machine-to-machine) ------------------------------ #}
{%- if auth_scenario == "client_credentials" %}
  access_type                  = "CONFIDENTIAL"
  standard_flow_enabled        = false
  direct_access_grants_enabled = false
  implicit_flow_enabled        = false
  service_accounts_enabled     = true

  valid_redirect_uris = []
{%- endif %}

  authentication_flow_binding_overrides {
    browser_id = keycloak_authentication_flow.custom-browser-login.id
  }
}

// LDAP_ID -> object_guid mapper (corporate convention for example-company realm)
resource "keycloak_openid_user_attribute_protocol_mapper" "{{app_name_tf}}_object_guid_mapper" {
  realm_id            = keycloak_realm.biocad.id
  client_id           = keycloak_openid_client.{{app_name_tf}}.id
  name                = "object_guid mapper"
  user_attribute      = "LDAP_ID"
  claim_name          = "object_guid"
  claim_value_type    = "String"
  add_to_id_token     = true
  add_to_access_token = true
  add_to_userinfo     = true
}

{%- if needs_roles %}

// Roles claim — emits resource_access.<client_id>.roles in the JWT
resource "keycloak_openid_user_client_role_protocol_mapper" "{{app_name_tf}}_role_mapper" {
  realm_id                    = keycloak_realm.biocad.id
  client_id                   = keycloak_openid_client.{{app_name_tf}}.id
  client_id_for_role_mappings = keycloak_openid_client.{{app_name_tf}}.client_id
  name                        = "user-client-role-mapper"
  claim_name                  = "resource_access.$${client_id}.roles"
  multivalued                 = true
  add_to_id_token             = false
  add_to_access_token         = true
}

// Bind roles to AD groups. Groups must already exist in route66_ldap_groups
// (and be synced from AD into Keycloak — up to 15 minutes after AD apply).
// If `keycloak-handoff/ldap-groups-snippet.tf` is part of this hand-off, that
// MR must be merged and applied BEFORE this client file is applied.
module "keycloak_{{app_name_tf}}_roles" {
  source    = "./modules/keycloak_client_roles"
  realm_id  = keycloak_realm.biocad.id
  client_id = keycloak_openid_client.{{app_name_tf}}.id
  roles = [
{%- for role in roles %}
    {
      name            = "{{role.name}}"
      description     = "{{role.description}}"
      ldap_group_name = "KC-Role-{{app_name_lower}}-{{role.name_lower}}"
    },
{%- endfor %}
  ]
}
{%- endif %}

{%- if auth_scenario == "client_credentials" and service_audience %}

// Audience mapper — adds {{service_audience}} as `aud` in access tokens
resource "keycloak_openid_audience_protocol_mapper" "{{app_name_tf}}_audience_mapper" {
  realm_id                 = keycloak_realm.biocad.id
  client_id                = keycloak_openid_client.{{app_name_tf}}.id
  included_client_audience = "{{service_audience}}"
  name                     = "audience-mapper"
  add_to_id_token          = false
  add_to_access_token      = true
}
{%- endif %}
