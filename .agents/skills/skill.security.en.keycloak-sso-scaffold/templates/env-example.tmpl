{# Snapshot of the Keycloak env vars the application expects.
   Render to: keycloak-handoff/.env.example  (alongside the TF snippets).
   This is reference material for the DevOps ticket — the developer's REAL
   .env* lives wherever their app already keeps it (e.g. .env.template).
   Only include the CLIENT_SECRET line for confidential / client_credentials clients.
-#}
# Keycloak SSO env reference — generated by keycloak-sso-scaffold on {{generated_at}}
# App:           {{app_name}}
# Auth scenario: {{auth_scenario}} ({{client_type_or_m2m}})
#
# This file is part of the handoff to the SSO platform team. It documents the
# variables the application will consume once DevOps creates the matching
# Keycloak client. The developer fills the actual values into their real
# .env (or .env.template) once DevOps confirms apply is green.

KEYCLOAK_URL=https://route66.biocad.ru
KEYCLOAK_REALM={{realm}}
KEYCLOAK_CLIENT_ID={{app_name}}
{%- if client_type == "confidential" or auth_scenario == "client_credentials" %}

# Obtain from DevOps after the route66 MR is merged and applied.
# Do NOT commit this value. The Keycloak Admin UI is the source of truth:
#   Clients -> {{app_name}} -> Credentials -> Client secret
KEYCLOAK_CLIENT_SECRET=
{%- endif %}
{%- if auth_scenario == "auth_code" %}

# The first redirect URI registered for this client. Add the rest in your app config.
KEYCLOAK_REDIRECT_URI={{redirect_uris[0]}}
{%- endif %}

# Discovery / well-known endpoint:
#   ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration
