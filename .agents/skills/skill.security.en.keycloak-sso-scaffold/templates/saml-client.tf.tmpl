{# SAML client template — minimal modern profile.
   Signing/encryption keys are NOT set here; DevOps adds them via var.saml_*
   after the MR is merged.
   Substitute every {{placeholder}}.
   Render to: keycloak-handoff/{{app_name}}.tf  (inside the developer's repo).
   DevOps will copy this file to: route66/TFCODE/{{app_name}}_saml.tf
   Run `terraform fmt` after writing.
-#}
// ============================================================================
//  HANDOFF FILE FOR THE SSO PLATFORM TEAM (SAML)
//  Source app:        {{source_app_repo}}
//  Generated by:      keycloak-sso-scaffold skill on {{generated_at}}
//
//  DevOps action: copy this file to `route66/TFCODE/{{app_name}}_saml.tf`,
//                 open an MR, apply, then wire up SAML signing/encryption
//                 keys via var.saml_* (sourced from Vault) so SP metadata
//                 export is complete.
//
//  Signing / encryption keys are NOT set in this snippet by design.
// ============================================================================

resource "keycloak_saml_client" "{{app_name_tf}}" {
  realm_id  = keycloak_realm.biocad.id
  client_id = "{{sp_entity_id}}"
  name      = "{{sp_entity_id}}"

  enabled                   = true
  login_theme               = "keycloak"
  signature_algorithm       = "RSA_SHA256"
  client_signature_required = false
  sign_documents            = true
  sign_assertions           = true
  include_authn_statement   = false
  name_id_format            = "{{name_id_format}}"
  force_name_id_format      = false
  front_channel_logout      = true

  authentication_flow_binding_overrides {
    browser_id = keycloak_authentication_flow.custom-browser-login.id
  }

  valid_redirect_uris = [
    "{{acs_url}}",
  ]
}

{%- if needs_roles %}

// Bind SAML roles to AD groups. SAML roles are exposed via a role-list mapper.
// Groups must already exist in route66_ldap_groups.
module "keycloak_{{app_name_tf}}_roles" {
  source    = "./modules/keycloak_client_roles"
  realm_id  = keycloak_realm.biocad.id
  client_id = keycloak_saml_client.{{app_name_tf}}.id
  roles = [
{%- for role in roles %}
    {
      name            = "{{role.name}}"
      description     = "{{role.description}}"
      ldap_group_name = "KC-Role-{{app_name_lower}}-{{role.name_lower}}"
    },
{%- endfor %}
  ]
}
{%- endif %}
