{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/sanitizer-launcher.mjs cursor-session", "timeout": 10}
    ],
    "preToolUse": [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/sanitizer-launcher.mjs cursor-file-write", "timeout": 10, "matcher": "Write|Edit"}
    ],
    "postToolUse": [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/sanitizer-launcher.mjs cursor-file-read", "timeout": 10, "matcher": "Read"}
    ],
    "postToolUseFailure":   [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "beforeShellExecution": [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "afterShellExecution":  [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "beforeMCPExecution":   [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/before-mcp-execution.js"}
    ],
    "afterMCPExecution":    [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/after-mcp-execution.js"}
    ],
    "beforeReadFile":       [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/before-read-file.js"}
    ],
    "beforeTabFileRead":    [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/before-tab-file-read.js"}
    ],
    "afterFileEdit":        [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "afterTabFileEdit":     [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "beforeSubmitPrompt":   [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/before-submit-prompt.js"},
      {"command": "node .cursor/hooks/sanitizer-launcher.mjs cursor-in", "timeout": 10}
    ],
    "afterAgentResponse":   [
      {"command": "node .cursor/hooks/gitleaks-launcher.mjs"},
      {"command": "node .cursor/hooks/sanitizer-launcher.mjs cursor-out", "timeout": 10}
    ],
    "afterAgentThought":    [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "subagentStart":        [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "subagentStop":         [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "sessionEnd":           [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "stop":                 [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}],
    "preCompact":           [{"command": "node .cursor/hooks/gitleaks-launcher.mjs"}]
  }
}
