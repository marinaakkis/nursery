{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "preToolUse": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "postToolUse": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ],
    "postToolUseFailure": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ],
    "beforeShellExecution": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "afterShellExecution": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ],
    "beforeMCPExecution": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "afterMCPExecution": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ],
    "beforeReadFile": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "beforeTabFileRead": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15, "failClosed": true}
    ],
    "afterFileEdit": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ],
    "afterTabFileEdit": [
      {"command": "node scripts/ai-hooks/run-hook-tool.mjs gitleaks -- --client cursor", "timeout": 15}
    ]
  }
}
